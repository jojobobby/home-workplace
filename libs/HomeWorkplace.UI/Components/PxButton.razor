@namespace HomeWorkplace.UI.Components

@* type="button": never a form submitter, so a button inside a create form fires its own handler exactly once. *@
<button type="button" class="px-btn @Variant @CssClass" disabled="@Disabled" @onclick="OnClick">@ChildContent</button>

@code {
    /// <summary>primary | danger | ghost (default styling when empty).</summary>
    [Parameter] public string Variant { get; set; } = "";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
