@namespace HomeWorkplace.UI.Components

<button class="slot state-@State @(Selected ? "selected" : "")" data-id="@DataId" title="@Tooltip" @onclick="OnClick">@ChildContent</button>

@code {
    /// <summary>awake | working | waiting | asleep — drives the border colour.</summary>
    [Parameter] public string State { get; set; } = "";
    [Parameter] public string? DataId { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
