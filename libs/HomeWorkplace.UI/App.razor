@implements IDisposable
@inject AppStore Store
@inject ShellState Shell

@* The shell: nav rail, the current screen, toasts. The MAUI host renders this and nothing else. *@
<div id="hw-root" class="hw">
    <nav class="nav-rail">
        <div class="brand">Home Workplace</div>
        @foreach (var s in AllScreens)
        {
            <button type="button" class="nav-link @(Shell.Current == s ? "active" : "")" data-screen="@s.ToString().ToLowerInvariant()" @onclick="() => Shell.Go(s)">
                <span>@s</span>
                @if (s == Screen.Tasks) { <PxBadge Count="Store.HumanNeeded" OnClick="Shell.ShowWhatNeedsMe" /> }
            </button>
        }
        @if (!Store.ServicesUp) { <div class="reconnect">connecting…</div> }
    </nav>

    <main class="screen">
        @switch (Shell.Current)
        {
            case Screen.Office: <Office /> break;
            case Screen.Employees: <Employees /> break;
            case Screen.Tasks: <Tasks /> break;
            case Screen.Goals: <Goals /> break;
            case Screen.Activity: <Activity /> break;
            case Screen.Setup: <Setup /> break;
        }
    </main>

    <PxToast Toasts="Store.Toasts" OnDismiss="Store.DismissToast" />
</div>

@code {
    private static readonly Screen[] AllScreens = Enum.GetValues<Screen>();

    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        Shell.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        Shell.Changed -= OnChanged;
    }
}
