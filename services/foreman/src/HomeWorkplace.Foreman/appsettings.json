{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5172" },
      "Https": { "Url": "https://localhost:7172" }
    }
  },
  "Foreman": {
    "EmployeesPath": "../../../../employees",
    "HiringPath": "../../../../hiring",
    "DataPath": "./data",
    "ContextApiBaseUrl": "http://localhost:5171",
    "ClaudeExecutable": "claude",
    "CodexExecutable": "codex",
    "MaxRunMinutes": 30,
    "SchedulerTickSeconds": 30,
    "EventsCapacity": 5000,
    "MaxHandoffDepth": 5
  }
}
